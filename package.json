{
  "name": "upl-weekplanner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync-core": "node scripts/sync-core.mjs",
    "predev": "npm run sync-core",
    "dev": "vite",
    "prebuild": "npm run sync-core",
    "build": "vue-tsc --noEmit && vite build",
    "import:day-planner": "node scripts/import-day-planner.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
